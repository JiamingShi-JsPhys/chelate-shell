{
  "name": "chelate-shell",
  "version": "1.3.6",
  "description": "Nineteen research and engineering skills run as one gated pipeline for DeepSeek Harness and other agent hosts: falsifiable gates (atom conservation, CAS and units, Crossref DOI, ML leakage, OBJ mesh) block the stages downstream of a failure instead of passing it along.",
  "main": "index.js",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-skills",
    "orchestration",
    "pipeline",
    "gates",
    "research",
    "python"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JiamingShi-JsPhys/chelate-shell.git"
  },
  "homepage": "https://github.com/JiamingShi-JsPhys/chelate-shell#readme",
  "bugs": {
    "url": "https://github.com/JiamingShi-JsPhys/chelate-shell/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "cli.py",
    "bootstrap.py",
    "core/",
    "lib/",
    "contracts/",
    "skills/",
    "commands/",
    "agents/",
    "examples/"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "prepublishOnly": "node scripts/clean-pycache.mjs"
  }
}
